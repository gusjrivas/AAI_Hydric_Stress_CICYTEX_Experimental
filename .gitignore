# Credenciales de fuentes de datos externas (ver docs/research/hu2-fuentes-datos-acceso.md)
.cdsapirc
.netrc
.env
*.env
credentials.json
secrets.json

# Los datos locales (ADR-0002: Parquet/CSV) SÍ se versionan en git, junto con
# su diccionario de datos — ver docs/adr/0002-stack-tecnico-poc.md. No hay
# regla de exclusión acá a propósito.

# Entornos y artefactos de Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Artefactos de MLflow (ADR-0002)
mlruns/
mlartifacts/

# Registro de retroalimentación generado por la UI local (alerting-ui): es
# estado de ejecución efímero de uso local, no un dataset curado — a
# diferencia de los datasets reales de HU2, no tiene sentido versionarlo.
data/feedback_ui.parquet

# Metadato de identidad de código generado por docker/experiment-v4/build.py
# y embebido al construir esa imagen (hallazgo H-05, ver code_identity.py).
# Nunca se versiona: se regenera en cada build a partir del checkout real.
.build_identity.json

# Manifiestos y datos generados por scripts/demo_simulation (HU6, change
# add-accelerated-sensor-demo): estado de ejecución sintético y efímero de
# una demo local, no un dataset curado — misma razón que data/feedback_ui.parquet.
demo_sessions/
data/sensor__demo-*.parquet
data/feedback__demo-*.parquet

# Laboratorio de sensores de prueba (tercer modo de la UI de defensa,
# capacidad alerting-ui): cada sesión usa un sensor_id propio con prefijo
# lab- (frontend/src/features/lab/labSensor.ts), datos sintéticos aislados
# y descartables de la misma naturaleza que demo_sessions/ arriba.
data/sensor__lab-*.parquet
data/feedback__lab-*.parquet

# Reproducción histórica (change add-causal-historical-replay): el paquete
# científico autorizado (replay_packages/) SÍ se versiona, igual que
# data/*.parquet (es pequeño y es la evidencia archivada del candidato). El
# feedback de demostración y el estado de las sesiones de demo, en cambio,
# son registros operativos efímeros de uso local — misma razón que
# demo_sessions/ y data/feedback_ui.parquet: nunca se versionan, pero
# tampoco se borran (quedan como evidencia local de cada verificación).
replay_feedback/
data/cicytex_replay_sessions.sqlite3*
/data/.cicytex_replay_sessions.sqlite3.bootstrap.lock
.demo_replay_sessions/
.demo-defense-data/
frontend/.npm-cache/

# Dataset externo CICYTEX: copia de trabajo local y artefactos pesados.
# Solo se versionan manifiestos, resultados agregados y documentación.
/data/cicytex/raw/
/data/cicytex/work/
/data/cicytex/*.zip
/data/cicytex/**/*.parquet
/results/cicytex/causal_replay/models/

# Estado efímero de arranque local (PIDs/logs) de
# scripts/start_defense_demo.ps1 — nunca se versiona.
.defense-demo-run/

# ZIP de intercambio para revisión de código entre pasos de este mismo
# *change*: no son entregables del repositorio, se generan y se leen
# localmente. Se preservan en disco, nunca se versionan.
/paso*-revision-codigo*.zip
/openspec/changes/add-causal-historical-replay.zip
/openspec/scientific-closure/causal-historical-replay-2026-09-22*.zip
/openspec/scientific-closure/causal-historical-replay-2026-09-22 (*).zip
